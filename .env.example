# Base URL of the data files (meta.json, *.parquet). Default /data: in dev served from ./data,
# in production streamed from the R2 binding DATA by src/routes/data/[...path]/+server.ts.
PUBLIC_DATA_URL=/data
# Item icon base URL: <base>/<icon>.jpg. Default: Wowhead image CDN (large = 56px; /medium used for tables).
PUBLIC_ICON_URL=https://wow.zamimg.com/images/wow/icons/large
# Optional self-hosted @duckdb/duckdb-wasm dist dir. Empty = jsDelivr.
PUBLIC_DUCKDB_BUNDLE_URL=
