{
	"name": "taptoah",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"data:pull": "node scripts/pull-data.mjs",
		"deploy": "pnpm build && wrangler pages deploy",
		"preview:cf": "pnpm build && wrangler pages dev"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261004.1",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"sirv": "^3.0.2",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"wrangler": "^4.147.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@duckdb/duckdb-wasm": "1.32.0",
		"@lucide/svelte": "^1.52.0",
		"uplot": "^1.6.32"
	},
	"description": "taptoAH: auction house price history for WoW 3.3.5a (WotLK) private servers. Static SvelteKit + DuckDB-WASM over Parquet.",
	"license": "MIT"
}
